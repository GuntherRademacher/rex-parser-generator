        charclass = 0;
      }

      state = code;
      int i0 = (charclass << 3) + code - 1;
      code = TRANSITION[(i0 & 3) + TRANSITION[i0 >> 2]];

      if (code > 7)
      {
        result = code;
        code &= 7;
        end = current;
      }
