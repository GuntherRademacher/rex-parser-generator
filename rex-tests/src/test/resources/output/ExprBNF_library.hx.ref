class ParseException
{
  private var begin: Int;
  private var end: Int;
  private var state: Int;
  private var offending: Int;
  private var expected: Int;

  public function new(b, e, s, o, x)
  {
    begin = b;
    end = e;
    state = s;
    offending = o;
    expected = x;
  }

  public function getBegin() {return begin;}
  public function getEnd() {return end;}
  public function getState() {return state;}
  public function getExpected() {return expected;}
  public function getOffending() {return offending;}

  public function getMessage()
  {
    return offending < 0
         ? "lexical analysis failed"
         : "syntax error";
  }
}

interface EventHandler
{
  public function reset(input: Bytes): Void;
  public function startNonterminal(id: Int, begin: Int): Void;
  public function endNonterminal(id: Int, end: Int): Void;
  public function terminal(id: Int, begin: Int, end: Int): Void;
  public function whitespace(begin: Int, end: Int): Void;
}

interface BottomUpEventHandler
{
  public function reset(input: Bytes): Void;
  public function nonterminal(id: Int, begin: Int, end: Int, count: Int): Void;
  public function terminal(id: Int, begin: Int, end: Int): Void;
}

class Symbol
{
  public var id: Int;
  public var begin: Int;
  public var end: Int;

  private function new(id, begin, end)
  {
    this.id = id;
    this.begin = begin;
    this.end = end;
  }

  public function getName(): String {return null;}

  public function send(e: EventHandler) {}
}

class Terminal extends Symbol
{
  public function new(id, begin, end)
  {
    super(id, begin, end);
  }

  override
  public function getName(): String
  {
    return ExprBNF_library.TOKEN[id];
  }

  override
  public function send(e: EventHandler)
  {
    e.terminal(id, begin, end);
  }
}

class Nonterminal extends Symbol
{
  public var children: Array<Symbol>;

  public function new(id, begin, end, children)
  {
    super(id, begin, end);
    this.children = children;
  }

  override
  public function getName(): String
  {
    return ExprBNF_library.NONTERMINAL[id];
  }

  override
  public function send(e: EventHandler)
  {
    e.startNonterminal(id, begin);
    var pos = begin;
    for (c in children)
    {
      if (pos < c.begin) e.whitespace(pos, c.begin);
      c.send(e);
      pos = c.end;
    }
    if (pos < end) e.whitespace(pos, end);
    e.endNonterminal(id, end);
  }
}

class ParseTreeBuilder implements BottomUpEventHandler
{
  var input : Bytes;
  var stack = new Array<Symbol>();
  var top = -1;

  public function new() {}

  public function reset(input: Bytes)
  {
    this.input = input;
    top = -1;
  }

  public function nonterminal(id: Int, begin: Int, end: Int, count: Int)
  {
    push(new Nonterminal(id, begin, end, pop(count)));
  }

  public function terminal(id: Int, begin: Int, end: Int)
  {
    push(new Terminal(id, begin, end));
  }

  public function getRoot(): Symbol
  {
    return top >= 0 ? stack[0] : null;
  }

  public function serialize(e: EventHandler)
  {
    e.reset(input);
    var i = 0;
    while (i <= top)
    {
      stack[i].send(e);
      ++i;
    }
  }

  public function push(s: Symbol)
  {
    stack[++top] = s;
  }

  public function pop(count: Int)
  {
     top -= count;
     return stack.slice(top + 1, top + count + 1);
  }
}

