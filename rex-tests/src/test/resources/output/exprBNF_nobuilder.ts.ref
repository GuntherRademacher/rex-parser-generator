  export abstract class Symbol
  {
    public id: number;
    public begin: number;
    public end: number;

    constructor(id: number, begin: number, end: number)
    {
      this.id = id;
      this.begin = begin;
      this.end = end;
    }

    public abstract getName(): string;

    public abstract send(e: ParsingEventHandler): void;
  }

  export class Terminal extends Symbol
  {
    constructor(id: number, begin: number, end: number)
    {
      super(id, begin, end);
    }

    public getName(): string
    {
      return Parser.TOKEN[this.id];
    }

    public send(e: ParsingEventHandler): void
    {
      e.terminal(this.id, this.begin, this.end);
    }
  }

  export class Nonterminal extends Symbol
  {
    public children: Symbol[];

    constructor(id: number, begin: number, end: number, children: Symbol[])
    {
      super(id, begin, end);
      this.children = children;
    }

    public getName(): string
    {
      return Parser.NONTERMINAL[this.id];
    }

    public send(e: ParsingEventHandler): void
    {
      e.startNonterminal(this.id, this.begin);
      var pos = this.begin;
      this.children.forEach
      (
        function(c): void
        {
          if (pos < c.begin) e.whitespace(pos, c.begin);
          c.send(e);
          pos = c.end;
        }
      );
      if (pos < this.end) e.whitespace(pos, this.end);
      e.endNonterminal(this.id, this.end);
    }
  }

  export class ParseTreeBuilder implements BottomUpEventHandler
  {
    private input!: string;
    private stack: Symbol[] = [];
    private top!: number;

    public reset(input: string): void
    {
      this.input = input;
      this.top = -1;
    }

    public getStack(): Symbol[] {return this.stack;}
    public getTop(): number {return this.top;}

    public nonterminal(id: number, begin: number, end: number, count: number): void
    {
      this.push(new Nonterminal(id, begin, end, this.pop(count)));
    }

    public terminal(id: number, begin: number, end: number): void
    {
      this.push(new Terminal(id, begin, end));
    }

    public getRoot(): Symbol | null
    {
      return this.top >= 0 ? this.stack[0] : null;
    }

    public serialize(e: ParsingEventHandler): void
    {
      e.reset(this.input);
      for (var i = 0; i <= this.top; ++i)
      {
        this.stack[i].send(e);
      }
    }

    public push(s: Symbol): void
    {
      this.stack[++this.top] = s;
    }

    public pop(count: number): Symbol[]
    {
      this.top -= count;
      return this.stack.slice(this.top + 1, this.top + 1 + count);
    }
  }
}

class XmlSerializer implements exprBNF_nobuilder.ParsingEventHandler
{
  private input!: string;
  private delayedTag: string | null = null;
  private indent: boolean;
  private hasChildElement!: boolean;
  private depth!: number;

  constructor(indent: boolean)
  {
    this.indent = indent;
  }

  reset(source: string)
  {
    proc.stdout.write("<?xml version=\"1.0\" encoding=\"UTF-8\"?" + ">");
    this.input = source;
    this.hasChildElement = false;
    this.depth = 0;
  }

  startNonterminal(id: number, begin: number)
  {
    this.startElement(exprBNF_nobuilder.Parser.getNonterminalName(id));
  }

  private startElement(tag: string)
  {
    if (this.delayedTag != null)
    {
      proc.stdout.write("<");
      proc.stdout.write(this.delayedTag);
      proc.stdout.write(">");
    }
    this.delayedTag = tag;
    if (this.indent)
    {
      proc.stdout.write("\n");
      for (var i = 0; i < this.depth; ++i)
      {
        proc.stdout.write("  ");
      }
    }
    this.hasChildElement = false;
    ++this.depth;
  }

  endNonterminal(id: number, end: number)
  {
    this.endElement(exprBNF_nobuilder.Parser.getNonterminalName(id));
  }

  private endElement(tag: string)
  {
    --this.depth;
    if (this.delayedTag != null)
    {
      this.delayedTag = null;
      proc.stdout.write("<");
      proc.stdout.write(tag);
      proc.stdout.write("/>");
    }
    else
    {
      if (this.indent)
      {
        if (this.hasChildElement)
        {
          proc.stdout.write("\n");
          for (var i = 0; i < this.depth; ++i)
          {
            proc.stdout.write("  ");
          }
        }
      }
      proc.stdout.write("</");
      proc.stdout.write(tag);
      proc.stdout.write(">");
    }
    this.hasChildElement = true;
  }

  terminal(id: number, begin: number, end: number)
  {
    var tag = exprBNF_nobuilder.Parser.getTerminalName(id);
    if (tag.charAt(0) == '\'') tag = "TOKEN";
    this.startElement(tag);
    this.characters(begin, end);
    this.endElement(tag);
  }

  whitespace(begin: number, end: number)
  {
    this.characters(begin, end);
  }

  private characters(begin: number, end: number)
  {
    if (begin < end)
    {
      if (this.delayedTag != null)
      {
        proc.stdout.write("<");
        proc.stdout.write(this.delayedTag);
        proc.stdout.write(">");
        this.delayedTag = null;
      }
      proc.stdout.write(this.input.substring(begin, end)
                 .replace(/&/g, "&amp;")
                 .replace(/</g, "&lt;")
                 .replace(/>/g, "&gt;"));
    }
  }
}

// main program for use with node.js

const proc: any = (globalThis as any).process;
const requ: any = eval("require");
const fs: any = requ("fs");

if (proc.argv.length < 3)
{
  proc.stderr.write("Usage: node exprBNF_nobuilder.js [-i] INPUT...\n");
  proc.stderr.write("\n");
  proc.stderr.write("  parse INPUT, which is either a filename or literal text enclosed in curly braces\n");
  proc.stderr.write("\n");
  proc.stderr.write("  Option:\n");
  proc.stderr.write("    -i     indented parse tree\n");
}
else
{
  var indent = false;
  for (var i = 2; i < proc.argv.length; ++i)
  {
    var arg = proc.argv[i];
    if (arg === "-i")
    {
      indent = true;
      continue;
    }
    var input: string;
    if (/^{.*}$/.test(arg))
    {
      input = arg.substring(1, arg.length - 1);
    }
    else
    {
      var content = fs.readFileSync(arg, "utf-8");
      input = content.length > 0 && content.charCodeAt(0) == 0xFEFF
            ? content.substring(1)
            : content;
    }
    var s = new XmlSerializer(indent);
    var t = new exprBNF_nobuilder.ParseTreeBuilder();
    var parser = new exprBNF_nobuilder.Parser(input, t);
    try
    {
      parser.parse_input();
      t.serialize(s);
    }
    catch (pe)
    {
      if (! (pe instanceof exprBNF_nobuilder.ParseException))
      {
        throw pe;
      }
      else
      {
        throw parser.getErrorMessage(pe);
      }
    }
  }
}

// End
